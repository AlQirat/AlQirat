# Admin dashboard login (/admin). Choose your own values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings > Database). Only used locally by `npm run db:migrate`;
# it is not needed on Vercel.

Direct_connection_str=

# ImageKit (Developer options)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Brevo transactional email (used for customer email OTP authentication)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Razorpay (keep all three values server-side; use Test Mode keys during testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
